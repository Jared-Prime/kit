{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "allow": ["WebSearch"],
    "deny": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git -C:*)"
    ]
  },
  "allowManagedPermissionRulesOnly": true,
  "env": {
    "DISABLE_AUTOUPDATER": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
  }
}
